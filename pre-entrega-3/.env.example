LLM_PROVIDER=gemini

# Gemini Developer API (API key) — often hits free-tier 429s
GEMINI_API_KEY=

# Gemini via Vertex AI (recommended if the API key keeps 429'ing)
# Uses Application Default Credentials, not GEMINI_API_KEY.
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- RAG semántico local (opcional, con defaults en config.py) ---
# Tamaño del chunk y solapamiento para RecursiveCharacterTextSplitter
CHUNK_SIZE=800
CHUNK_OVERLAP=50

# Cantidad de fragmentos recuperados por consulta (top_k, consigna: 3-5)
TOP_K=4

# Umbral de relevancia (similitud coseno, 0-1): por debajo se descarta el
# fragmento y, si ninguno pasa, la respuesta es "No lo sé". Calibrado en 0.30
# para el corpus actual con MiniLM multilingual; recalibrar si cambia el corpus.
SIMILARITY_THRESHOLD=0.30

# Modelo de embeddings local (mismo modelo para indexar y consultar)
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Nombre de la colección en ChromaDB
COLLECTION_NAME=apuntes

# Rutas de persistencia y corpus (por defecto ./vectorstore y ./data)
# VECTORSTORE_DIR=
# DATA_DIR=
