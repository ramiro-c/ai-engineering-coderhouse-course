# Copiá este archivo a .env y completá las claves. Nunca commitees el .env real.

# --- Credenciales ---
# Pinecone (Serverless, free tier). La usan init_index.py e ingest.py.
PINECONE_API_KEY=

# OpenAI, para embeddings (text-embedding-3-small).
OPENAI_API_KEY=

# Nombre del índice Serverless (se crea con 1536 dimensiones y métrica cosine).
INDEX_NAME=pre-entrega-4-rag

# --- Opcionales (defaults en config.py) ---
# Chunking en tokens (tiktoken cl100k_base). La consigna pide 500-800 tokens.
# CHUNK_SIZE=700
# CHUNK_OVERLAP=100

# Documentos recuperados por consulta.
# TOP_K=5

# Modelo de embeddings. No cambiarlo sin recrear el índice (debe coincidir la
# dimensión).
# EMBEDDING_MODEL=text-embedding-3-small

# Vectores por lote en el upsert.
# BATCH_SIZE=100

# Constante c del Reciprocal Rank Fusion y región del índice Serverless.
# RRF_C=60
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
