# Copiá este archivo a .env y completá las claves. Nunca commitees el .env real.

# --- Credenciales ---
# Clave de API de Pinecone (Serverless, free tier). La usa init_index.py para
# crear/verificar el índice e ingest.py para el upsert.
PINECONE_API_KEY=

# Clave de API de OpenAI. Se usa para embeddings (text-embedding-3-small) y,
# en la evolución B, para el pipeline de respuesta.
OPENAI_API_KEY=

# Nombre del índice Serverless en Pinecone. init_index.py lo crea con dimensión
# 1536 y métrica cosine si no existe (idempotente).
INDEX_NAME=pre-entrega-4-rag

# --- Si copiaste el .env de pre-entrega-3, borrá estas claves heredadas ---
# CHUNK_SIZE=400 / CHUNK_OVERLAP=50 / TOP_K=4  -> pisarían los defaults de P4
#    (700/100/5) y romperían el rango de 500-800 tokens de la consigna.
# EMBEDDING_MODEL=sentence-transformers/...   -> pisaría text-embedding-3-small
#    y rompería la dimensión 1536 del índice.
# SIMILARITY_THRESHOLD / COLLECTION_NAME / LLM_PROVIDER / GEMINI_API_KEY /
# ANTHROPIC_API_KEY / OPENROUTER_API_KEY      -> no se usan en pre-entrega-4.

# --- Opcionales (defaults en config.py) ---
# Tamaño y solapamiento del chunk, medidos en TOKENS (tiktoken cl100k_base).
# La consigna pide chunks de 500-800 tokens.
# CHUNK_SIZE=700
# CHUNK_OVERLAP=100

# Cantidad de documentos recuperados por consulta (top_k).
# TOP_K=5

# Modelo de embeddings (text-embedding-3-small, 1536 dimensiones). No cambiarlo
# sin recrear el índice: la dimensión debe coincidir.
# EMBEDDING_MODEL=text-embedding-3-small

# Cantidad de vectores por lote en el upsert.
# BATCH_SIZE=100

# Constante c del Reciprocal Rank Fusion y región del índice Serverless.
# RRF_C=60
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1
