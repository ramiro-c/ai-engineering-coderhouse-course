# Copiá este archivo a .env y completá las claves. Nunca commitees el .env real.

# --- Credenciales ---
# Pinecone (Serverless, free tier). La usan init_index.py e ingest.py.
PINECONE_API_KEY=

# Nombre del índice Serverless (se crea con 384 dimensiones y métrica cosine).
INDEX_NAME=pre-entrega-4-rag

# --- Credenciales GCP (solo para la generación con LLM, provider gemini) ---
# El provider gemini usa Vertex AI vía ADC/service account (ChatVertexAI), NO
# una GEMINI_API_KEY. Sin estas variables, la construcción del modelo falla y
# responder() devuelve answered=false (edge controlado, no rompe el pipeline).
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=

# --- Opcionales (defaults en config.py) ---
# Chunking en tokens (tiktoken cl100k_base). La consigna pide 500-800 tokens.
# CHUNK_SIZE=700
# CHUNK_OVERLAP=100

# Documentos recuperados por consulta.
# TOP_K=5

# Modelo de embeddings LOCALES HuggingFace (all-MiniLM-L6-v2, 384d; el mismo
# de pre-entrega-3). Se descarga una vez a disco y luego se cachea. No
# cambiarlo sin recrear el índice: la dimensión debe coincidir (384d).
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Vectores por lote en el upsert.
# BATCH_SIZE=100

# Constante c del Reciprocal Rank Fusion y región del índice Serverless.
# RRF_C=60
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# Proveedor del LLM de generación (evolución B): gemini (default, vía Vertex
# AI/ADC), openai, anthropic u openrouter. Solo hace falta la credencial del
# provider activo (GCP vars para gemini, ANTHROPIC_API_KEY, OPENAI_API_KEY o
# la de OpenRouter).
# LLM_PROVIDER=gemini
