# Copiá este archivo a .env y completá las claves. Nunca commitees el .env real.

# --- Pinecone (obligatorio para indexar y evaluar) ---
PINECONE_API_KEY=
INDEX_NAME=pre-entrega-4-rag

# --- Generación con LLM (opcional: demo.py / RAGSystem.responder) ---
LLM_PROVIDER=gemini

# Gemini Developer API (API key) — útil para debug rápido; el free tier a veces da 429
GEMINI_API_KEY=

# Gemini vía Vertex AI (recomendado si la API key da 429 o para producción)
# Usa Application Default Credentials, no GEMINI_API_KEY.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_APPLICATION_CREDENTIALS=
# GOOGLE_CLOUD_PROJECT=
# GOOGLE_CLOUD_LOCATION=

# Otros proveedores (cambiá LLM_PROVIDER). OpenRouter es útil para validar sin Vertex.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# --- Embeddings locales (sin API key) ---
# Modelo HuggingFace all-MiniLM-L6-v2 (384d). No cambiarlo sin recrear el índice.
# EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Opcionales (defaults en config.py) ---
# Chunking en tokens (tiktoken cl100k_base). La consigna pide 500-800 tokens.
# CHUNK_SIZE=700
# CHUNK_OVERLAP=100

# Documentos recuperados por consulta.
# TOP_K=5

# Vectores por lote en el upsert.
# BATCH_SIZE=100

# Constante c del Reciprocal Rank Fusion y región del índice Serverless.
# RRF_C=60
# PINECONE_CLOUD=aws
# PINECONE_REGION=us-east-1

# HF_HUB_OFFLINE: exportala en la shell, no acá. huggingface_hub la lee en
# import time y load_dotenv() llega tarde.
#   export HF_HUB_OFFLINE=1
